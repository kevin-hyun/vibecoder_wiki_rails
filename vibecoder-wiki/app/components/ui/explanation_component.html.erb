<div id="explanation-<%= explanation.id %>" class="relative bg-white rounded-lg border border-gray-200 p-4 <%= compact_mode ? 'mb-3' : 'mb-6' %> hover:shadow-md transition-shadow duration-200">
  <%= best_explanation_badge %>
  
  <div class="flex items-start space-x-3">
    <!-- 작성자 아바타 -->
    <div class="flex-shrink-0">
      <img class="h-8 w-8 rounded-full object-cover"
           src="<%= author_avatar_url %>"
           alt="<%= author_display_name %>"
           loading="lazy">
    </div>
    
    <div class="min-w-0 flex-1">
      <!-- 작성자 정보 및 메타데이터 -->
      <div class="flex items-center justify-between mb-2">
        <div class="flex items-center space-x-2">
          <h4 class="text-sm font-medium text-gray-900">
            <%= author_display_name %>
            <%= author_badge %>
          </h4>
          <span class="text-xs text-gray-500">
            <%= time_ago_in_words(explanation.created_at) %> 전
          </span>
        </div>
        
        <!-- 난이도 배지 -->
        <span class="inline-flex items-center px-2 py-1 text-xs font-medium rounded-full <%= difficulty_badge_class %>">
          <%= difficulty_text %>
        </span>
      </div>
      
      <!-- 설명 내용 -->
      <div class="prose prose-sm max-w-none mb-4">
        <div class="text-gray-800 leading-relaxed">
          <%= formatted_content %>
        </div>
        
        <!-- 일상 비유가 있는 경우 -->
        <% if formatted_analogy.present? %>
          <div class="mt-3 p-3 bg-blue-50 border-l-4 border-blue-400 rounded-r-lg">
            <div class="flex items-start">
              <div class="flex-shrink-0">
                <span class="text-blue-600 text-lg">💡</span>
              </div>
              <div class="ml-2">
                <p class="text-sm text-blue-800 font-medium">일상 비유로 설명하면</p>
                <p class="text-sm text-blue-700 mt-1"><%= formatted_analogy %></p>
              </div>
            </div>
          </div>
        <% end %>
        
        <!-- 구체적 예시가 있는 경우 -->
        <% if formatted_example.present? %>
          <div class="mt-3 p-3 bg-green-50 border-l-4 border-green-400 rounded-r-lg">
            <div class="flex items-start">
              <div class="flex-shrink-0">
                <span class="text-green-600 text-lg">📝</span>
              </div>
              <div class="ml-2">
                <p class="text-sm text-green-800 font-medium">구체적인 예시</p>
                <p class="text-sm text-green-700 mt-1"><%= formatted_example %></p>
              </div>
            </div>
          </div>
        <% end %>
      </div>
      
      <!-- 태그 -->
      <% if tags_display.any? %>
        <div class="flex flex-wrap gap-1 mb-3">
          <% tags_display.each do |tag| %>
            <span class="inline-flex items-center px-2 py-1 text-xs font-medium rounded <%= tag_color_class(tag) %>">
              #<%= tag %>
            </span>
          <% end %>
        </div>
      <% end %>
      
      <!-- 액션 버튼들 -->
      <% if show_actions %>
        <div class="flex items-center justify-between pt-3 border-t border-gray-100">
          <!-- 투표 버튼 -->
          <div id="explanation-votes-<%= explanation.id %>" class="flex items-center space-x-2">
            <%= button_to vote_concept_explanation_path(concept, explanation, vote_type: 'helpful'),
                method: :patch,
                remote: true,
                class: vote_button_class('helpful'),
                title: '이 설명이 도움됐어요',
                form_class: "inline" do %>
              <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V9a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L9 11m-4 8a2 2 0 01-2-2V9a2 2 0 012-2h2m4 8V9"/>
              </svg>
              도움됐어요
              <%= vote_count_display('helpful', helpful_votes_count) %>
            <% end %>
            
            <%= button_to vote_concept_explanation_path(concept, explanation, vote_type: 'difficult'),
                method: :patch,
                remote: true,
                class: vote_button_class('difficult'),
                title: '조금 더 쉽게 설명해주시면 좋겠어요',
                form_class: "inline" do %>
              <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14H5.236a2 2 0 01-1.789-2.894l3.5-7A2 2 0 018.737 3h4.018c.163 0 .326.02.485.06L17 4m-7 10v2a2 2 0 002 2h.095c.5 0 .905-.405.905-.905 0-.714.211-1.412.608-2.006L15 17m-4-4.5V9a2 2 0 00-2-2H7"/>
              </svg>
              어려워요
              <%= vote_count_display('difficult', difficult_votes_count) %>
            <% end %>
          </div>
          
          <!-- 작성자/관리자 액션 버튼 -->
          <div class="flex items-center space-x-2">
            <% if can_make_best? %>
              <%= button_to make_best_concept_explanation_path(concept, explanation),
                  method: :patch,
                  remote: true,
                  class: "inline-flex items-center px-2 py-1 text-xs font-medium text-yellow-600 hover:text-yellow-700 border border-yellow-300 rounded hover:bg-yellow-50 transition-colors",
                  title: "베스트 설명으로 선정",
                  confirm: "이 설명을 베스트 설명으로 선정하시겠어요?",
                  form_class: "inline" do %>
                ⭐ 베스트 선정
              <% end %>
            <% end %>
            
            <% if can_edit? %>
              <%= link_to edit_concept_explanation_path(concept, explanation),
                  class: "inline-flex items-center px-2 py-1 text-xs font-medium text-indigo-600 hover:text-indigo-700 border border-indigo-300 rounded hover:bg-indigo-50 transition-colors",
                  title: "설명 수정" do %>
                ✏️ 수정
              <% end %>
            <% end %>
            
            <% if can_delete? %>
              <%= button_to concept_explanation_path(concept, explanation),
                  method: :delete,
                  remote: true,
                  class: "inline-flex items-center px-2 py-1 text-xs font-medium text-red-600 hover:text-red-700 border border-red-300 rounded hover:bg-red-50 transition-colors",
                  title: "설명 삭제",
                  confirm: "정말로 이 설명을 삭제하시겠어요?",
                  form_class: "inline" do %>
                🗑️ 삭제
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>