<div class="relative bg-white rounded-lg border border-gray-200 shadow-sm hover:shadow-md transition-all duration-200 group overflow-hidden">
  <%= verification_badge %>
  <%= popularity_indicator %>
  
  <!-- 카드 헤더 -->
  <div class="p-4 pb-3">
    <div class="flex items-start justify-between mb-2">
      <h3 class="text-lg font-semibold text-gray-900 group-hover:text-indigo-600 transition-colors line-clamp-1">
        <%= link_to concept.title, concept_path(concept), class: "hover:underline" %>
      </h3>
      
      <% if show_bookmark && current_user %>
        <div id="bookmark-button-<%= concept.id %>">
          <%= render "concepts/bookmark_button", concept: concept, bookmarked: is_bookmarked? %>
        </div>
      <% end %>
    </div>
    
    <!-- 카테고리 및 난이도 배지 -->
    <div class="flex flex-wrap gap-2 mb-3">
      <span class="inline-flex items-center px-2 py-1 text-xs font-medium rounded-full <%= category_badge_class %>">
        <%= category_text %>
      </span>
      <span class="inline-flex items-center px-2 py-1 text-xs font-medium border rounded-full <%= difficulty_badge_class %>">
        <%= difficulty_text %>
      </span>
    </div>
    
    <!-- 간단한 정의 -->
    <p class="text-sm text-gray-600 mb-4 line-clamp-2 leading-relaxed">
      <%= truncated_definition %>
    </p>
  </div>
  
  <!-- 카드 푸터 -->
  <div class="px-4 pb-4">
    <div class="flex items-center justify-between text-xs text-gray-500">
      <div class="flex items-center space-x-3">
        <!-- 조회수 -->
        <span class="flex items-center">
          <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
          </svg>
          <%= number_with_delimiter(concept.view_count) %>
        </span>
        
        <!-- 설명 개수 -->
        <span class="flex items-center">
          <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
          </svg>
          <%= total_explanations_count %>개 설명
        </span>
        
        <% if best_explanations_count > 0 %>
          <span class="flex items-center text-yellow-600">
            <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
            베스트 <%= best_explanations_count %>개
          </span>
        <% end %>
      </div>
      
      <!-- 작성일 -->
      <span class="text-gray-400">
        <%= time_ago_in_words(concept.created_at) %> 전
      </span>
    </div>
  </div>
  
  <!-- 호버 효과용 오버레이 -->
  <div class="absolute inset-0 bg-gradient-to-r from-indigo-500 to-purple-500 opacity-0 group-hover:opacity-5 transition-opacity duration-200 pointer-events-none"></div>
</div>